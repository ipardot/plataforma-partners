---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'es' | 'en';
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'La plataforma para conocer, vivir y construir Partners Campus EAFIT.',
  lang = 'es',
  image = '/uploads/eventos/lani-2026.jpg',
  noindex = false,
} = Astro.props;

const tituloCompleto = title === 'Inicio' ? 'Partners Campus EAFIT' : `${title} · Partners Campus EAFIT`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Aplica el tema antes de pintar para evitar parpadeos.
      (() => {
        const r = document.documentElement;
        let t = null;
        try {
          t = localStorage.getItem('pce-tema');
        } catch {}
        if (t) r.dataset.theme = t;
        const sistema = matchMedia('(prefers-color-scheme: dark)');
        const aplicar = () => (r.dataset.temaActivo = (r.dataset.theme || (sistema.matches ? 'dark' : 'light')));
        aplicar();
        sistema.addEventListener('change', aplicar);
        r.classList.add('js');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content="#4e689b" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1626" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins800} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="saltar" href="#contenido">{lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}</a>
    <Header lang={lang} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      // Aparición suave de tarjetas y bloques al hacer scroll.
      const revelar = document.querySelectorAll('#contenido .tarjeta, #contenido .revelar, #contenido .evento, #contenido .macro');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entradas) =>
            entradas.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -40px 0px' },
        );
        revelar.forEach((el) => {
          if (el.getBoundingClientRect().top > innerHeight) {
            el.classList.add('por-revelar');
            io.observe(el);
          }
        });
      }
    </script>
    <script>
      // Solo en desarrollo (npm run dev): resalta los textos marcados como [PENDIENTE ...] o [EJEMPLO]
      // para que la Junta los complete. En la página publicada se muestran como texto normal.
      if (import.meta.env.DEV) {
        const walker = document.createTreeWalker(document.getElementById('contenido')!, NodeFilter.SHOW_TEXT);
        const nodos: Text[] = [];
        while (walker.nextNode()) {
          const n = walker.currentNode as Text;
          if (n.nodeValue && /\[(PENDIENTE|EJEMPLO)[^\]]*\]/.test(n.nodeValue)) nodos.push(n);
        }
        for (const n of nodos) {
          const span = document.createElement('span');
          span.innerHTML = n.nodeValue!
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/\[(PENDIENTE|EJEMPLO)([^\]]*)\]/g, '<mark class="pendiente" title="Contenido por completar desde el CMS">[$1$2]</mark>');
          n.replaceWith(...span.childNodes);
        }
      }
    </script>
  </body>
</html>
