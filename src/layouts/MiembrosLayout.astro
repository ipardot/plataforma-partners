---
import Layout from './Layout.astro';

interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
const actual = Astro.url.pathname.replace(/\/$/, '');
const links = [
  ['/miembros', 'Inicio', false],
  ['/miembros/biblioteca', 'Biblioteca', false],
  ['/miembros/directorio', 'Directorio', false],
  ['/miembros/participacion', 'Mi participación', false],
  ['/miembros/admin', 'Administrar', true],
] as const;
---

<Layout title={title} noindex>
  <section class="cabeza-privada">
    <div class="contenedor">
      <span class="eyebrow">Área privada · solo integrantes</span>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <nav class="subnav" aria-label="Área privada">
        {
          links.map(([href, label, junta]) => (
            <a href={href} aria-current={actual === href ? 'page' : undefined} data-solo-junta={junta || undefined} hidden={junta}>
              {label}
            </a>
          ))
        }
        <button type="button" class="subnav__salir" data-salir>Cerrar sesión</button>
      </nav>
    </div>
  </section>
  <section class="seccion">
    <div class="contenedor">
      <div id="gate"><p class="cargando">Verificando tu acceso…</p></div>
      <div id="app" hidden><slot /></div>
    </div>
  </section>
</Layout>

<style>
  .cabeza-privada {
    background: var(--profundo);
    color: #fff;
    padding-block: 40px 0;
  }
  .cabeza-privada .eyebrow {
    color: var(--salmon);
  }
  .cabeza-privada h1 {
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .cabeza-privada .lead {
    color: #c9d2e3;
  }
  .subnav {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    margin-top: 16px;
  }
  .subnav a,
  .subnav__salir {
    flex-shrink: 0;
    color: #c9d2e3;
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 10px 10px 0 0;
    font-weight: 500;
    font-size: 0.93rem;
    background: none;
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }
  .subnav a[hidden] {
    display: none;
  }
  .subnav a[aria-current='page'] {
    background: var(--fondo);
    color: var(--tinta);
  }
  .subnav__salir {
    margin-left: auto;
  }
  .cargando {
    color: var(--tinta-suave);
  }
  :global(.aviso-gate) {
    max-width: 560px;
  }
</style>
