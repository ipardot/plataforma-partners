---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { CATEGORIA_OPORTUNIDAD, fecha } from '../lib/nav';
import { cdn } from '../lib/img';

const todas = (await getCollection('oportunidades')).sort((a, b) => a.data.orden - b.data.orden);
const ops = await Promise.all(todas.map(async (o) => ({ o, Content: (await render(o)).Content })));
---

<Layout title="Oportunidades" description="Roles de liderazgo, Buddy Program y programas de Partners of the Americas para los integrantes de Partners Campus EAFIT.">
  <PageHero
    eyebrow="Oportunidades y crecimiento"
    title="Crece con Partners"
    lead="Lidera un macroevento, dirige una actividad, acompaña a un estudiante internacional o participa en los programas de nuestra red. Cada oportunidad indica quién puede participar y cómo acceder."
    sticker="/marca/sticker-5.webp"
  />

  <section class="seccion">
    <div class="contenedor">
      <div class="ops">
        {
          ops.map(({ o, Content }) => (
            <article class:list={['tarjeta', 'op', { 'op--cerrada': !o.data.activa }]} id={o.id}>
              {o.data.imagen && <img class="op__img" src={cdn(o.data.imagen, 640)} alt="" loading="lazy" width="640" height="360" />}
              <div class="op__cuerpo">
                <div class="op__cabeza">
                  <span class="etiqueta etiqueta--salmon">{CATEGORIA_OPORTUNIDAD[o.data.categoria]}</span>
                  {o.data.cierra && <span class="etiqueta etiqueta--obligatoria">Cierra el {fecha(o.data.cierra)}</span>}
                </div>
                <h2 class="op__titulo">{o.data.titulo}</h2>
                <div class="op__texto">
                  <Content />
                </div>
                <dl class="op__datos">
                  <dt>¿Quién puede participar?</dt>
                  <dd>{o.data.quien}</dd>
                  {o.data.requisitos.length > 0 && (
                    <>
                      <dt>¿Cómo acceder?</dt>
                      <dd>
                        <ul>
                          {o.data.requisitos.map((r) => (
                            <li>{r}</li>
                          ))}
                        </ul>
                      </dd>
                    </>
                  )}
                </dl>
                <div class="op__acciones">
                  {o.data.enlace && (
                    <a class="btn btn--primario" href={o.data.enlace} target="_blank" rel="noopener">
                      Ir a la convocatoria
                    </a>
                  )}
                  {o.data.evento && (
                    <a class="btn btn--borde" href={`/eventos/${o.data.evento}`}>
                      Conocer el evento
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .ops {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(16px, 2.5vw, 24px);
  }
  .op {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    scroll-margin-top: 96px;
  }
  .op:target {
    outline: 3px solid var(--salmon);
  }
  .op--cerrada {
    background: var(--fondo-alt);
  }
  .op__img {
    width: 100%;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }
  .op__cuerpo {
    padding: clamp(20px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .op__cabeza {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .op__titulo {
    font-size: 1.25rem;
    margin: 12px 0 6px;
  }
  .op__texto {
    color: var(--tinta-suave);
    font-size: 0.95rem;
  }
  .op__texto :global(h3) {
    font-size: 1.02rem;
    color: var(--tinta);
    margin-top: 1em;
  }
  .op__datos {
    font-size: 0.92rem;
    margin: 0 0 16px;
  }
  .op__datos dt {
    font-weight: 600;
    margin-top: 8px;
  }
  .op__datos dd {
    margin: 0;
    color: var(--tinta-suave);
  }
  .op__datos ul {
    margin: 0;
    padding-left: 1.2em;
  }
  .op__acciones {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
