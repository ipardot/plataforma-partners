---
import { cdn, srcset } from '../lib/img';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import sitio from '../data/sitio.json';

const MAPA =
  'https://www.google.com/maps/d/embed?mid=1pe0tf44qs4y9IlyYyLl7rSP9YN8ISho&ll=9.980674389919525%2C-78.76104455000001&z=3';
const MAPA_COMPLETO =
  'https://www.google.com/maps/d/u/0/viewer?mid=1pe0tf44qs4y9IlyYyLl7rSP9YN8ISho&ll=9.980674389919525%2C-78.76104455000001&z=3';

const indice = [
  ['que-es', '¿Qué es Partners?'],
  ['red', 'Partners of the Americas'],
  ['pilares', 'Pilares'],
  ['valores', 'Valores'],
  ['como-funciona', '¿Cómo funciona?'],
];

const valores = [
  {
    nombre: 'Conectar',
    sticker: '/marca/sticker-8.webp',
    texto: 'Gestionamos alianzas nacionales e internacionales entre capítulos de Partners of the Americas y acompañamos a los estudiantes de intercambio en EAFIT.',
    ejemplos: ['El Buddy Program acompaña a los estudiantes internacionales.', 'La Noche Internacional y CUPA acercan culturas.', 'Somos parte de una red de capítulos en las Américas.'],
  },
  {
    nombre: 'Servir',
    sticker: '/marca/sticker-6.webp',
    texto: 'Creamos iniciativas sociales que impactan a las comunidades, basadas en el trabajo mancomunado, la empatía y la tolerancia.',
    ejemplos: ['Voluntarios por un Día con fundaciones aliadas.', 'Salidas de voluntariado durante el semestre.'],
  },
  {
    nombre: 'Cambiar vidas',
    sticker: '/marca/sticker-2.webp',
    texto: 'Nos formamos en liderazgo y desarrollamos habilidades para la vida profesional y personal, dentro y fuera de Partners.',
    ejemplos: ['Dirigir un evento o un comité.', 'Capacitaciones como la de comunicación asertiva.', 'El Proyecto de nuevos y el Assessment.'],
  },
];

const fotos = [
  ['/uploads/galeria/grupo-1.jpg', 'Integrantes de Partners Campus EAFIT'],
  ['/uploads/galeria/vpud-4.jpg', 'Voluntarios por un Día'],
  ['/uploads/galeria/lani-2.jpg', 'La Noche Internacional'],
];
---

<Layout title="¿Qué es Partners?" description="Identidad, propósito, pilares, valores y funcionamiento de Partners Campus EAFIT, capítulo de Partners of the Americas.">
  <PageHero
    eyebrow="Conoce Partners"
    title="¿Qué es Partners Campus EAFIT?"
    lead="Un grupo estudiantil sin ánimo de lucro de la Universidad EAFIT y capítulo estudiantil de Partners of the Americas. Unimos el voluntariado, las relaciones internacionales y el desarrollo humano."
    sticker="/marca/sticker-8.webp"
  />

  <nav class="contenedor indice" aria-label="En esta página">
    {indice.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
  </nav>

  <section id="que-es" class="seccion">
    <div class="contenedor dos">
      <div>
        <span class="eyebrow">Nuestra identidad</span>
        <h2>Ser Partner</h2>
        <p>
          Partners Campus EAFIT (P.C.E) es una organización privada, apolítica, no sectaria y sin fines de lucro, cuyo
          propósito es promover la amistad, el voluntariado, la comunicación y el entendimiento entre la gente de América
          Latina, el Caribe y los Estados Unidos.
        </p>
        <p>
          Ser Partner es comprometerse con un grupo que sirve, conecta culturas y forma líderes. Es trabajar en equipo
          por proyectos propios, con responsabilidades reales y con una red internacional detrás.
        </p>
        <blockquote class="mision">
          <span class="eyebrow">Misión</span>
          <p>
            “Promover las relaciones internacionales y el voluntariado por medio de iniciativas y proyectos propios, para
            que, a través de la potencialización de capacidades y habilidades de trabajo en equipo, compromiso y liderazgo
            en los voluntarios, se fomente el bienestar social y la internacionalización”.
          </p>
          <cite>Estatutos 2026, Capítulo I</cite>
        </blockquote>
      </div>
      <div class="collage" aria-hidden="true">
        {
          fotos.map(([src, alt], i) => (
            <img
              class:list={['collage__foto', `collage__foto--${i}`]}
              src={cdn(src, 640)}
              srcset={srcset(src, [400, 640, 900])}
              sizes="(min-width: 900px) 30vw, 60vw"
              alt={alt}
              loading="lazy"
              width="640"
              height="480"
            />
          ))
        }
        <img class="collage__sticker" src="/marca/sticker-6.webp" alt="" width="90" height="75" loading="lazy" />
      </div>
    </div>
    <div class="contenedor">
      <h3 class="subtitulo">Lo que hacemos</h3>
      <ol class="funciones grid grid--2">
        <li>Generar impacto social con proyectos de educación, medio ambiente, cultura y más.</li>
        <li>Fortalecer lazos internacionales entre estudiantes extranjeros y estudiantes de EAFIT.</li>
        <li>Potenciar las capacidades de los miembros en un ambiente de trabajo real.</li>
        <li>Trabajar con otros grupos estudiantiles y capítulos de la red en proyectos de interés humano.</li>
        <li>Fomentar relaciones entre capítulos de Partners of the Americas.</li>
      </ol>
    </div>
  </section>

  <section id="red" class="seccion seccion--azul">
    <div class="contenedor">
      <div class="dos">
        <div>
          <span class="eyebrow">Nuestra red internacional</span>
          <h2>Partners of the Americas</h2>
          <p>
            Partners of the Americas es una organización no gubernamental, apolítica y sin fines de lucro, con oficina
            internacional en Washington, DC. Funciona a través de una red de <strong>capítulos</strong> en todo el
            continente que se conectan para promover el desarrollo social y económico en las Américas.
          </p>
          <p>
            Partners Campus EAFIT es un <strong>capítulo afiliado y autosostenible</strong>: hacemos programas de la red o
            programas propios, siempre alineados con su misión y con los valores de EAFIT.
          </p>
          <a class="btn btn--primario" href={sitio.partnersAmericas} target="_blank" rel="noopener">Visitar partners.net</a>
        </div>
        <div class="tarjeta beneficios">
          <img class="sticker" src="/marca/sticker-3.webp" alt="" width="64" height="40" loading="lazy" />
          <h3>Beneficios de unirse a un capítulo</h3>
          <ul class="lista-check">
            <li>Oportunidades para establecer contactos y comenzar a desarrollar una red de colegas locales e internacionales.</li>
            <li>Oportunidades de voluntariado y desarrollo profesional a través de los programas y actividades de la sección local.</li>
            <li>Oportunidades de liderazgo a través de la Junta Directiva de la sección local.</li>
            <li>¡Mucho más!</li>
          </ul>
        </div>
      </div>

      <div class="mapa">
        <div class="mapa__texto">
          <h3>Encuentra todos los capítulos de la red</h3>
          <p>
            En este mapa están los capítulos de Partners of the Americas a los que pertenecemos como red. Acércate o aléjate
            con los botones <strong>+</strong> y <strong>−</strong>, y haz clic en cualquier punto para ver el nombre del
            capítulo y su información.
          </p>
          <p>
            ¿Quieres conectar con alguno? Escríbele a la <a href="/comites/rrpp">Dirección de Relaciones Públicas</a>, que
            mantiene el contacto con los demás capítulos.
          </p>
          <a class="btn btn--borde" href={MAPA_COMPLETO} target="_blank" rel="noopener">Abrir el mapa en pantalla completa</a>
        </div>
        <div class="mapa__marco">
          <iframe src={MAPA} title="Mapa de capítulos de Partners of the Americas" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>

      <div class="ww tarjeta">
        <div class="ww__icono" aria-hidden="true"><img src="/marca/sticker-8.webp" alt="" width="72" height="72" loading="lazy" /></div>
        <div>
          <span class="eyebrow">Eventos de la red</span>
          <h3>What Works Conference</h3>
          <p>
            Es uno de los eventos más importantes de Partners of the Americas. Reúne a los miembros de la Comunidad de
            Partners y a la comunidad internacional de desarrollo para <strong>compartir prácticas basadas en evidencia</strong>,
            fortalecer las alianzas entre organizaciones y entre personas, y celebrar el impacto del desarrollo liderado
            localmente y del voluntariado en las Américas y más allá.
          </p>
          <p>
            <strong>Convocatoria abierta:</strong> Partners invita a presentar una Expresión de Interés para ser el
            Anfitrión Principal de la What Works Conference 2028 en América Latina y el Caribe. Fecha límite: viernes 27 de
            noviembre de 2026, 11:59 p. m. (hora del Este de EE. UU.).
          </p>
          <p class="ww__otros">La red también ofrece capacitaciones y eventos de aprendizaje como <strong>Partners Connect</strong> y <strong>Peer Learning Events</strong>.</p>
          <a class="btn btn--primario" href="/oportunidades#programas-partners-americas">Ver la convocatoria</a>
        </div>
      </div>
    </div>
  </section>

  <section id="pilares" class="seccion">
    <div class="contenedor">
      <span class="eyebrow">Nuestros ejes de trabajo</span>
      <h2>Voluntariado e Internacional</h2>
      <div class="grid grid--2">
        <article class="tarjeta pilar pilar--salmon">
          <img class="pilar__foto" src={cdn('/uploads/galeria/vpud-1.jpg', 720)} alt="Voluntarios por un Día" loading="lazy" width="720" height="400" />
          <h3>Voluntariado</h3>
          <p>
            Desarrollamos iniciativas de impacto social, generamos experiencias de servicio y construimos relaciones con
            fundaciones, comunidades y poblaciones beneficiarias. Lo lidera el <a href="/comites/social">Comité Social</a>.
          </p>
          <p><a href="/eventos/voluntarios-por-un-dia">Voluntarios por un Día</a> · <a href="/eventos/salidas-fundaciones">Salidas a fundaciones</a></p>
        </article>
        <article class="tarjeta pilar pilar--azul">
          <img class="pilar__foto" src={cdn('/uploads/galeria/lani-4.jpg', 720)} alt="La Noche Internacional" loading="lazy" width="720" height="400" />
          <h3>Internacional</h3>
          <p>
            Promovemos el intercambio cultural, la integración de estudiantes extranjeros, el aprendizaje intercultural y
            la conexión con oportunidades globales. Lo lidera el <a href="/comites/internacional">Comité Internacional</a>.
          </p>
          <p>
            <a href="/eventos/la-noche-internacional">La Noche Internacional</a> · <a href="/eventos/cupa">CUPA</a> ·
            <a href="/eventos/buddy-program">Buddy Program</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="valores" class="seccion seccion--alt">
    <div class="contenedor">
      <span class="eyebrow">Nuestros valores</span>
      <h2>Conectar, servir y cambiar vidas</h2>
      <p class="lead">No son solo conceptos institucionales: orientan cómo trabajamos, cómo nos relacionamos y cómo generamos impacto.</p>
      <div class="grid grid--3">
        {
          valores.map((v) => (
            <article class="tarjeta">
              <img class="sticker" src={v.sticker} alt="" width="64" height="64" loading="lazy" />
              <h3>{v.nombre}</h3>
              <p>{v.texto}</p>
              <p class="ejemplos-titulo">Así se vive:</p>
              <ul class="ejemplos">
                {v.ejemplos.map((e) => <li>{e}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="como-funciona" class="seccion">
    <div class="contenedor">
      <span class="eyebrow">Estructura</span>
      <h2>¿Cómo funciona Partners?</h2>
      <p class="lead">Así nos organizamos, en cinco ideas.</p>
      <ol class="pasos-fn">
        <li class="tarjeta">
          <span class="pasos-fn__num">1</span>
          <h3>Tenemos una Junta Directiva</h3>
          <p>
            Siete directores elegidos cada año por los miembros: Presidencia, Vicepresidencia Financiera y las direcciones de
            Gestión Humana, Mercadeo, Internacional, Social y Relaciones Públicas. Coordinan el grupo y se reúnen mínimo dos
            veces al mes.
          </p>
          <a href="/junta">Conoce la Junta →</a>
        </li>
        <li class="tarjeta">
          <span class="pasos-fn__num">2</span>
          <h3>Trabajamos en comités</h3>
          <p>
            Internacional, Social, Logística, Mercadeo, Relaciones Públicas y Gestión Humana. Todo miembro pertenece al
            menos a uno; en tu semestre de nuevo estás en Internacional o Social y puedes sumarte a los demás.
          </p>
          <a href="/comites">Explora los comités →</a>
        </li>
        <li class="tarjeta">
          <span class="pasos-fn__num">3</span>
          <h3>Decidimos en Asamblea</h3>
          <p>
            Hay mínimo una Asamblea General al mes, abierta a todos los miembros. Ahí se informa, se debate y se vota; cada
            año se elige la Junta Directiva.
          </p>
          <a href="/vida-interna#asambleas">Cómo funcionan las asambleas →</a>
        </li>
        <li class="tarjeta">
          <span class="pasos-fn__num">4</span>
          <h3>Llevamos una tabla de permanencia</h3>
          <p>
            Cada semestre la Junta hace seguimiento a la participación de cada miembro en comités, asambleas, reuniones y
            eventos. Participar suma puntos, una excusa válida no suma ni resta y faltar sin excusa resta.
          </p>
          <a href="/vida-interna#permanencia">Cómo funciona la tabla →</a>
        </li>
        <li class="tarjeta">
          <span class="pasos-fn__num">5</span>
          <h3>Seleccionamos cada semestre</h3>
          <p>
            Cada semestre hacemos un proceso de selección con <strong>tres filtros</strong> para recibir a los nuevos
            Partners. Quienes pasan entran como miembros nuevos en periodo de prueba durante su primer semestre.
          </p>
          <a href="/eventos/assessment">Conoce el Assessment →</a>
        </li>
      </ol>
    </div>
  </section>
</Layout>

<style>
  .indice {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-block: 16px;
    scrollbar-width: thin;
  }
  .indice a {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--borde);
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--tinta);
  }
  .indice a:hover {
    background: var(--inspiracion-claro);
  }
  .dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 56px);
    align-items: start;
  }
  .dos .btn {
    margin: 8px 8px 0 0;
  }
  .mision {
    margin: 24px 0 0;
    padding: 28px;
    border-radius: var(--radio);
    background: var(--degradado);
    color: #fff;
  }
  .mision .eyebrow {
    color: #fff;
    opacity: 0.85;
  }
  .mision p {
    font-size: 1.05rem;
    font-weight: 500;
  }
  .mision cite {
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .collage {
    position: relative;
    min-height: 460px;
  }
  .collage__foto {
    position: absolute;
    object-fit: cover;
    border-radius: var(--radio);
    border: 6px solid var(--superficie);
    box-shadow: var(--sombra-fuerte);
  }
  .collage__foto--0 {
    width: 72%;
    aspect-ratio: 4 / 3;
    top: 0;
    right: 0;
    transform: rotate(2deg);
  }
  .collage__foto--1 {
    width: 58%;
    aspect-ratio: 4 / 3;
    top: 42%;
    left: 0;
    transform: rotate(-3deg);
  }
  .collage__foto--2 {
    width: 46%;
    aspect-ratio: 1;
    bottom: -10px;
    right: 6%;
    transform: rotate(4deg);
  }
  .collage__sticker {
    position: absolute;
    top: 30%;
    left: 6%;
    width: 84px;
    height: auto;
    transform: rotate(-12deg);
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.2));
  }
  .subtitulo {
    margin-top: 48px;
  }
  .funciones {
    padding: 0;
    list-style: none;
    counter-reset: f;
  }
  .funciones li {
    counter-increment: f;
    padding: 16px 16px 16px 56px;
    position: relative;
    background: var(--fondo-alt);
    border-radius: var(--radio-sm);
  }
  .funciones li::before {
    content: counter(f);
    position: absolute;
    left: 16px;
    top: 14px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--salmon);
    color: var(--profundo);
    font-weight: 700;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
  }
  .lista-check {
    padding-left: 1.2em;
  }
  .lista-check li {
    margin-bottom: 6px;
  }
  .beneficios .sticker {
    width: 64px;
    height: auto;
  }
  .mapa {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(20px, 4vw, 40px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .mapa__marco {
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra-fuerte);
    border: 6px solid var(--superficie);
    aspect-ratio: 16 / 10;
    background: var(--superficie);
  }
  .mapa__marco iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .ww {
    display: flex;
    gap: 24px;
    margin-top: clamp(32px, 5vw, 56px);
    border-left: 6px solid var(--salmon);
  }
  .ww__icono img {
    width: 72px;
    height: auto;
  }
  .ww p {
    color: var(--tinta-suave);
  }
  .ww__otros {
    font-size: 0.92rem;
  }
  .pilar {
    padding-top: 0;
    overflow: hidden;
  }
  .pilar__foto {
    width: calc(100% + 2 * clamp(20px, 3vw, 28px));
    max-width: none;
    margin: 0 calc(-1 * clamp(20px, 3vw, 28px)) 18px;
    aspect-ratio: 16 / 8;
    object-fit: cover;
  }
  .pilar--salmon {
    border-top: 6px solid var(--salmon);
  }
  .pilar--azul {
    border-top: 6px solid var(--confianza);
  }
  .ejemplos-titulo {
    font-weight: 600;
    margin-bottom: 4px;
  }
  .ejemplos {
    padding-left: 1.2em;
    color: var(--tinta-suave);
    font-size: 0.93rem;
    margin: 0;
  }
  .pasos-fn {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }
  .pasos-fn li {
    padding-top: 56px;
  }
  .pasos-fn__num {
    position: absolute;
    top: 18px;
    left: clamp(20px, 3vw, 28px);
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-weight: 800;
    color: #fff;
    background: var(--degradado);
    transform: rotate(-6deg);
  }
  .pasos-fn p {
    color: var(--tinta-suave);
  }
  .pasos-fn a {
    font-weight: 600;
    font-size: 0.92rem;
  }
  @media (max-width: 860px) {
    .dos,
    .mapa {
      grid-template-columns: 1fr;
    }
    .collage {
      min-height: 360px;
    }
    .ww {
      flex-direction: column;
    }
  }
</style>
