---
import MiembrosLayout from '../../layouts/MiembrosLayout.astro';
import { CATEGORIAS_BIBLIOTECA } from '../../lib/biblioteca';
---

<MiembrosLayout title="Biblioteca interna" lead="Documentos operativos de Partners. Usa siempre la versión vigente.">
  <div class="herramientas">
    <div class="campo">
      <label for="q">Buscar</label>
      <input id="q" type="search" placeholder="Título, descripción o responsable" autocomplete="off" />
    </div>
    <div class="campo">
      <label for="cat">Categoría</label>
      <select id="cat">
        <option value="">Todas</option>
        {Object.entries(CATEGORIAS_BIBLIOTECA).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </div>
  </div>

  <div id="lista" class="lista" aria-live="polite"></div>

  <details class="desplegable anteriores">
    <summary>Versiones anteriores (no vigentes)</summary>
    <div class="desplegable__cuerpo">
      <p class="aviso">Estos documentos se conservan como archivo histórico. <strong>No los uses como referencia actual.</strong></p>
      <div id="lista-antigua" class="lista"></div>
    </div>
  </details>

  <section class="tarjeta subir" data-solo-junta hidden>
    <h2>Subir documento</h2>
    <p>Al subir una nueva versión, marca la anterior como “no vigente” para que nadie la use por error.</p>
    <form id="form-doc">
      <div class="grid grid--2">
        <div class="campo"><label for="d-titulo">Título</label><input id="d-titulo" name="titulo" required /></div>
        <div class="campo">
          <label for="d-cat">Categoría</label>
          <select id="d-cat" name="categoria" required>
            {Object.entries(CATEGORIAS_BIBLIOTECA).map(([k, v]) => <option value={k}>{v}</option>)}
          </select>
        </div>
        <div class="campo"><label for="d-resp">Responsable</label><input id="d-resp" name="responsable" placeholder="Cargo o comité" /></div>
        <div class="campo"><label for="d-fecha">Fecha de actualización</label><input id="d-fecha" name="actualizado" type="date" required /></div>
      </div>
      <div class="campo"><label for="d-desc">Descripción</label><textarea id="d-desc" name="descripcion"></textarea></div>
      <div class="grid grid--2">
        <div class="campo"><label for="d-archivo">Archivo</label><input id="d-archivo" name="archivo" type="file" /></div>
        <div class="campo"><label for="d-enlace">…o enlace (Drive, Canva)</label><input id="d-enlace" name="enlace" type="url" placeholder="https://" /></div>
      </div>
      <button class="btn btn--primario" type="submit">Guardar documento</button>
      <p id="doc-msg" role="status"></p>
    </form>
  </section>
</MiembrosLayout>

<script>
  import { supabase, esc } from '../../lib/supabase';
  import { proteger } from '../../lib/gate';
  import { CATEGORIAS_BIBLIOTECA } from '../../lib/biblioteca';

  type Doc = {
    id: string; titulo: string; descripcion: string | null; categoria: string; responsable: string | null;
    actualizado: string; vigente: boolean; archivo: string | null; enlace: string | null;
  };

  (async () => {
    const s = await proteger();
    if (!s || !supabase) return;
    const sb = supabase;
    let docs: Doc[] = [];
    const q = document.getElementById('q') as HTMLInputElement;
    const cat = document.getElementById('cat') as HTMLSelectElement;
    const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    const fechaTxt = (f: string) => new Date(f + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });

    function tarjeta(d: Doc) {
      const acciones = [
        d.archivo ? `<button class="btn btn--primario btn-sm" data-abrir="${esc(d.archivo)}">Abrir</button>` : '',
        d.enlace ? `<a class="btn btn--primario btn-sm" href="${esc(d.enlace)}" target="_blank" rel="noopener">Abrir enlace</a>` : '',
        s!.esJunta ? `<button class="btn btn--borde btn-sm" data-vigente="${d.id}" data-valor="${!d.vigente}">${d.vigente ? 'Marcar no vigente' : 'Marcar vigente'}</button>` : '',
      ].join('');
      return `<article class="doc ${d.vigente ? '' : 'doc--antiguo'}">
        <div class="doc__info">
          <span class="etiqueta">${esc(CATEGORIAS_BIBLIOTECA[d.categoria] ?? d.categoria)}</span>
          ${d.vigente ? '' : '<span class="etiqueta etiqueta--obligatoria">No vigente</span>'}
          <h3>${esc(d.titulo)}</h3>
          ${d.descripcion ? `<p>${esc(d.descripcion)}</p>` : ''}
          <p class="doc__meta">Actualizado: ${fechaTxt(d.actualizado)}${d.responsable ? ` · Responsable: ${esc(d.responsable)}` : ''}</p>
        </div>
        <div class="doc__acciones">${acciones}</div>
      </article>`;
    }

    function pintar() {
      const t = norm(q.value.trim());
      const filtrados = docs.filter(
        (d) => (!cat.value || d.categoria === cat.value) && (!t || norm(`${d.titulo} ${d.descripcion ?? ''} ${d.responsable ?? ''}`).includes(t)),
      );
      const vig = filtrados.filter((d) => d.vigente);
      const ant = filtrados.filter((d) => !d.vigente);
      document.getElementById('lista')!.innerHTML = vig.length ? vig.map(tarjeta).join('') : '<p>No hay documentos con estos filtros.</p>';
      document.getElementById('lista-antigua')!.innerHTML = ant.length ? ant.map(tarjeta).join('') : '<p>No hay versiones anteriores.</p>';
    }

    async function cargar() {
      const { data, error } = await sb.from('documentos').select('*').order('categoria').order('actualizado', { ascending: false });
      if (error) {
        document.getElementById('lista')!.innerHTML = `<p>Error al cargar: ${esc(error.message)}</p>`;
        return;
      }
      docs = data as Doc[];
      pintar();
    }

    q.addEventListener('input', pintar);
    cat.addEventListener('change', pintar);

    document.addEventListener('click', async (e) => {
      const el = e.target as HTMLElement;
      const abrir = el.closest<HTMLElement>('[data-abrir]');
      if (abrir) {
        const { data, error } = await sb.storage.from('biblioteca').createSignedUrl(abrir.dataset.abrir!, 300);
        if (error) return alert('No se pudo abrir el archivo: ' + error.message);
        window.open(data.signedUrl, '_blank', 'noopener');
      }
      const vig = el.closest<HTMLElement>('[data-vigente]');
      if (vig) {
        await sb.from('documentos').update({ vigente: vig.dataset.valor === 'true' }).eq('id', vig.dataset.vigente!);
        cargar();
      }
    });

    const form = document.getElementById('form-doc') as HTMLFormElement;
    (form.elements.namedItem('actualizado') as HTMLInputElement).valueAsDate = new Date();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('doc-msg')!;
      const f = new FormData(form);
      const archivo = f.get('archivo') as File;
      const enlace = String(f.get('enlace') || '');
      if (!archivo?.size && !enlace) {
        msg.textContent = 'Sube un archivo o pega un enlace.';
        return;
      }
      msg.textContent = 'Guardando…';
      let ruta: string | null = null;
      if (archivo?.size) {
        ruta = `${f.get('categoria')}/${Date.now()}-${archivo.name.replace(/[^\w.\-]+/g, '_')}`;
        const { error } = await sb.storage.from('biblioteca').upload(ruta, archivo);
        if (error) {
          msg.textContent = 'Error al subir: ' + error.message;
          return;
        }
      }
      const { error } = await sb.from('documentos').insert({
        titulo: f.get('titulo'),
        categoria: f.get('categoria'),
        responsable: f.get('responsable') || null,
        actualizado: f.get('actualizado'),
        descripcion: f.get('descripcion') || null,
        archivo: ruta,
        enlace: enlace || null,
      });
      msg.textContent = error ? 'Error al guardar: ' + error.message : 'Documento guardado.';
      if (!error) {
        form.reset();
        (form.elements.namedItem('actualizado') as HTMLInputElement).valueAsDate = new Date();
        cargar();
      }
    });

    cargar();
  })();
</script>

<style>
  .herramientas {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
  }
  .lista {
    display: grid;
    gap: 12px;
    margin-bottom: 24px;
  }
  :global(.doc) {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 14px;
    padding: 16px 18px;
  }
  :global(.doc--antiguo) {
    background: var(--fondo-alt);
  }
  :global(.doc h3) {
    margin: 6px 0 2px;
    font-size: 1.05rem;
  }
  :global(.doc p) {
    margin: 0;
    color: var(--tinta-suave);
    font-size: 0.92rem;
  }
  :global(.doc__meta) {
    font-size: 0.82rem !important;
    margin-top: 4px !important;
  }
  :global(.doc__acciones) {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  :global(.btn-sm) {
    padding: 0.5em 1em;
    font-size: 0.85rem;
  }
  .subir {
    margin-top: 32px;
  }
  .subir[hidden] {
    display: none;
  }
  @media (max-width: 640px) {
    .herramientas {
      grid-template-columns: 1fr;
    }
    :global(.doc) {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
