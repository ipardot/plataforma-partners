---
import Layout from '../layouts/Layout.astro';
---

<Layout title="¡Gracias!" noindex>
  <section class="seccion">
    <div class="contenedor gracias">
      <img src="/marca/sticker-6.png" alt="" width="120" height="100" />
      <h1>¡Gracias por escribirnos!</h1>
      <p class="lead">Recibimos tu mensaje. Si dejaste tus datos, la Junta te responderá por correo.</p>
      <a class="btn btn--primario" href="/">Volver al inicio</a>
    </div>
  </section>
</Layout>

<style>
  .gracias {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 8px;
  }
</style>
