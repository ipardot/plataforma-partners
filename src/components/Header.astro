---
import { NAV } from '../lib/nav';

interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';
const NAV_EN = [
  ['/en#about', 'About us'],
  ['/en#pillars', 'What we do'],
  ['/en#events', 'Events'],
  ['/en#international', 'International students'],
  ['/en#contact', 'Contact'],
];
const activo = (href: string) => (href === '/' ? actual === '/' : actual === href || actual.startsWith(href + '/'));
const t = lang === 'en'
  ? { menu: 'Open menu', tema: 'Switch light/dark mode', inicio: 'Home', ingresar: 'Members' }
  : { menu: 'Abrir menú', tema: 'Cambiar modo claro/oscuro', inicio: 'Inicio', ingresar: 'Ingresar' };
---

<header class="cabecera">
  <div class="contenedor cabecera__fila">
    <a href={lang === 'en' ? '/en' : '/'} class="cabecera__logo" aria-label="Partners Campus EAFIT, inicio">
      <img class="logo logo--claro" src="/marca/logo-partners.webp" alt="Partners Campus" width="168" height="34" />
      <img class="logo logo--oscuro" src="/marca/logo-partners-blanco.webp" alt="" width="168" height="34" aria-hidden="true" />
    </a>

    <div class="cabecera__acciones-movil">
      <button class="tema" type="button" data-tema aria-label={t.tema} title={t.tema}>
        <svg class="tema__sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.2 4.2 6 6M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path></svg>
        <svg class="tema__luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
      </button>
      <button class="cabecera__menu" type="button" aria-expanded="false" aria-controls="nav-principal">
        <span class="sr-only">{t.menu}</span>
        <span aria-hidden="true" class="hamburguesa"><span></span></span>
      </button>
    </div>

    <nav id="nav-principal" class="nav" aria-label={lang === 'en' ? 'Main' : 'Principal'}>
      {lang === 'en' && NAV_EN.map(([href, label]) => <a href={href} class="nav__boton">{label}</a>)}
      {
        lang === 'es' && (
          <>
            <a href="/" class:list={['nav__boton', { 'nav__boton--activo': activo('/') }]} aria-current={activo('/') ? 'page' : undefined}>
              {t.inicio}
            </a>
            <a href="/ruta" class:list={['nav__ruta', { 'nav__ruta--activo': activo('/ruta') }]} aria-current={activo('/ruta') ? 'page' : undefined}>
              <img src="/marca/sticker-5.webp" alt="" width="22" height="18" />
              Ruta del nuevo Partner
            </a>
          </>
        )
      }
      {
        lang === 'es' &&
          NAV.map((g) => (
            <details class="nav__grupo">
              <summary class:list={['nav__boton', { 'nav__boton--activo': g.links.some((l) => activo(l.href)) }]}>{g.label}</summary>
              <ul class="nav__panel">
                {g.links.map((l) => (
                  <li>
                    <a href={l.href} aria-current={activo(l.href) ? 'page' : undefined}>
                      {l.icono && <img src={l.icono} alt="" width="36" height="36" loading="lazy" />}
                      <span class="nav__texto">
                        <strong>{l.label}</strong>
                        {l.desc && <span>{l.desc}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))
      }
      {lang === 'es' && <a href="/contacto" class:list={['nav__boton', { 'nav__boton--activo': activo('/contacto') }]}>Contacto</a>}
      <div class="nav__extra">
        <a href={lang === 'en' ? '/' : '/en'} class="nav__boton nav__idioma" lang={lang === 'en' ? 'es' : 'en'}>
          {lang === 'en' ? 'ES' : 'EN'}
        </a>
        <button class="tema tema--escritorio" type="button" data-tema aria-label={t.tema} title={t.tema}>
          <svg class="tema__sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"></circle><path d="M12 2v2.5M12 19.5V22M4.2 4.2 6 6M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"></path></svg>
          <svg class="tema__luna" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg>
        </button>
        <a href="/miembros" class="btn btn--primario nav__cta">{t.ingresar}</a>
      </div>
    </nav>
  </div>
  <div class="cabecera__franja" aria-hidden="true"></div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cabecera);
    backdrop-filter: saturate(1.4) blur(12px);
  }
  .cabecera__franja {
    height: 3px;
    background: linear-gradient(90deg, var(--confianza), var(--inspiracion), var(--salmon), var(--rojo));
  }
  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    gap: 16px;
  }
  .cabecera__logo {
    flex-shrink: 0;
  }
  .logo {
    width: 150px;
    height: auto;
  }
  .logo--oscuro {
    display: none;
  }
  :global([data-tema-activo='dark']) .logo--claro {
    display: none;
  }
  :global([data-tema-activo='dark']) .logo--oscuro {
    display: block;
  }

  .cabecera__acciones-movil {
    display: none;
    align-items: center;
    gap: 4px;
  }
  .cabecera__menu {
    background: none;
    border: 0;
    padding: 10px;
    margin-right: -10px;
    cursor: pointer;
  }
  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after,
  .hamburguesa span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--tinta);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .hamburguesa {
    position: relative;
    background: transparent;
  }
  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburguesa::before {
    top: -7px;
  }
  .hamburguesa::after {
    top: 7px;
  }
  [aria-expanded='true'] .hamburguesa span {
    opacity: 0;
  }
  [aria-expanded='true'] .hamburguesa::before {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  .tema {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--borde);
    background: var(--superficie);
    color: var(--tinta);
    cursor: pointer;
  }
  .tema:hover {
    border-color: var(--salmon);
  }
  .tema svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tema__luna {
    display: none;
  }
  :global([data-tema-activo='dark']) .tema__sol {
    display: none;
  }
  :global([data-tema-activo='dark']) .tema__luna {
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .nav > * {
    flex-shrink: 0;
  }
  .nav__grupo {
    position: relative;
  }
  .nav__boton {
    list-style: none;
    cursor: pointer;
    padding: 8px 9px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--tinta);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    position: relative;
  }
  .nav__boton::-webkit-details-marker {
    display: none;
  }
  summary.nav__boton::after {
    content: '';
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    opacity: 0.6;
    transition: transform 0.2s ease;
  }
  details[open] > summary.nav__boton::after {
    transform: translateY(1px) rotate(-135deg);
  }
  .nav__boton:hover,
  details[open] > .nav__boton {
    background: var(--inspiracion-claro);
    color: var(--tinta);
  }
  .nav__boton--activo {
    font-weight: 600;
  }
  .nav__boton--activo::before {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--confianza), var(--salmon));
  }
  .nav__ruta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    margin: 0 4px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--profundo);
    background: var(--salmon);
    box-shadow: 0 4px 14px rgb(253 124 94 / 0.35);
    transition: transform 0.15s ease;
  }
  .nav__ruta:hover {
    transform: translateY(-1px) rotate(-1deg);
    color: var(--profundo);
  }
  .nav__ruta img {
    width: 22px;
    height: auto;
  }
  .nav__ruta--activo {
    outline: 2px solid var(--profundo);
    outline-offset: 2px;
  }
  .nav__panel {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 320px;
    list-style: none;
    margin: 0;
    padding: 8px;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 16px;
    box-shadow: var(--sombra-fuerte);
    animation: aparecer 0.16s ease-out;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .nav__panel a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--tinta);
  }
  .nav__panel img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }
  .nav__panel a:hover img {
    transform: rotate(-8deg) scale(1.1);
  }
  .nav__texto {
    display: grid;
  }
  .nav__panel a:hover,
  .nav__panel a[aria-current='page'] {
    background: var(--inspiracion-claro);
  }
  .nav__panel strong {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav__texto span {
    font-size: 0.82rem;
    color: var(--tinta-suave);
  }
  .nav__extra {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: 4px;
  }
  .nav__idioma {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--tinta-suave);
  }
  .nav__cta {
    padding: 0.6em 1.2em;
  }

  @media (max-width: 1180px) {
    .cabecera__acciones-movil {
      display: flex;
    }
    .tema--escritorio {
      display: none;
    }
    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px var(--gutter) 24px;
      background: var(--fondo);
      border-bottom: 1px solid var(--borde);
      box-shadow: 0 16px 24px rgb(0 0 0 / 0.12);
      max-height: calc(100dvh - 71px);
      overflow-y: auto;
    }
    .nav.abierto {
      display: flex;
    }
    .nav__ruta {
      justify-content: center;
      margin: 4px 0 8px;
      padding: 12px;
      font-size: 1rem;
    }
    .nav__boton {
      justify-content: space-between;
      padding: 14px 4px;
      border-radius: 0;
      border-bottom: 1px solid var(--borde);
      font-size: 1rem;
    }
    .nav__boton--activo::before {
      display: none;
    }
    .nav__boton:hover,
    details[open] > .nav__boton {
      background: transparent;
    }
    .nav__panel {
      position: static;
      box-shadow: none;
      border: 0;
      padding: 4px 0 8px;
      min-width: 0;
      background: transparent;
      animation: none;
    }
    .nav__extra {
      margin: 16px 0 0;
      justify-content: space-between;
    }
    .nav__cta {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  const boton = document.querySelector<HTMLButtonElement>('.cabecera__menu');
  const nav = document.getElementById('nav-principal');
  const grupos = document.querySelectorAll<HTMLDetailsElement>('.nav__grupo');
  const escritorio = window.matchMedia('(min-width: 1181px)');

  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    nav?.classList.toggle('abierto', !abierto);
  });

  // En escritorio, solo un grupo abierto a la vez.
  grupos.forEach((g) =>
    g.addEventListener('toggle', () => {
      if (g.open && escritorio.matches) grupos.forEach((o) => o !== g && (o.open = false));
    }),
  );
  document.addEventListener('click', (e) => {
    if (!escritorio.matches) return;
    if (!(e.target as Element).closest('.nav__grupo')) grupos.forEach((g) => (g.open = false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') grupos.forEach((g) => (g.open = false));
  });

  // Modo claro / oscuro
  const raiz = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>('[data-tema]').forEach((b) =>
    b.addEventListener('click', () => {
      const nuevo = raiz.dataset.temaActivo === 'dark' ? 'light' : 'dark';
      raiz.dataset.theme = nuevo;
      raiz.dataset.temaActivo = nuevo;
      try {
        localStorage.setItem('pce-tema', nuevo);
      } catch {}
    }),
  );
</script>
